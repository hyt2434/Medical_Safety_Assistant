# Shared ignore rules for the repository (maintain this file only).
/.vscode/

# Local configuration; keep distributable examples
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# JavaScript dependencies and caches, including archived prototypes
node_modules/
.npm-cache/
.vite/
*.tsbuildinfo

