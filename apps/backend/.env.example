# Local development only. Never commit actual credentials.
BACKEND_PORT=8000
AUTH_ENV=development
AUTH_DB_PATH=artifacts/auth/dev.sqlite
AUTH_SEED_DEMO=1
AUTH_COOKIE_SECURE=0
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_LOGIN_IP_LIMIT=100
# Optional separate Auth PostgreSQL database; remove AUTH_DB_PATH when using it.
# AUTH_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/msa_auth
# Unified PostgreSQL: remove AUTH_DB_PATH, configure DB_* (or DATABASE_URL), then
# run python db/setup_system.py --apply. It backs up the DB and writes these keys:
# DATABASE_MODE=unified
# CORE_REFERENCE_BUILD=<published by setup_system.py>
# Core then derives its connection from Auth; no duplicate CORE_DB_DSN needed.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=medical_safety_assistant
# DB_USER=postgres
# DB_PASSWORD=<local password>
# Core V4 is provisioned separately via db/, never via Auth migrations.
# CORE_DB_DSN=host=127.0.0.1 port=5432 dbname=msa_core user=APP_USER connect_timeout=5
# CORE_REFERENCE_BUILD=<existing published Core build>
# Legacy migration input only. Runtime Auth/Core identities use the same UUID.
# Set AUTH_LEGACY_UUID_MAP only after verifying the one-to-one historical mapping.
# AUTH_LEGACY_TIMEZONE=UTC preserves the previous naive timestamp contract.
CORE_USER_BINDINGS={}
NLP_OLLAMA_MODEL=qwen3.5:9b
# Production: AUTH_ENV=production, AUTH_SEED_DEMO=0, secure HTTPS cookies/origin.
