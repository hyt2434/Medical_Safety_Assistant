# Local development only. Copy to .env; never commit actual credentials.
BACKEND_PORT=8000
AUTH_ENV=development
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_LOGIN_IP_LIMIT=100
# --- Shared application database (all modules) ---
# PostgreSQL 17. Create medical_safety_assistant before running migrations.
# Set DB_PASSWORD to your real password; no URL encoding is needed.
# Set DB_USER to your PostgreSQL login.
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="medical_safety_assistant"
DB_USER="postgres"
DB_PASSWORD="CHANGE_ME"
AUTH_SEED_DEMO=1
AUTH_COOKIE_SECURE=0
# --- Frontend origin allowed to call the backend ---
# Open this exact URL. If Vite changes port, update it and restart backend.
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173
