@startuml UC_08
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 40
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-08: Record Dose Status

' Figure 8 / UC-08; diagrams only.
' Text source: pa/pa2/Use-Case-Specification/sections/02-use-case-specifications.tex
' Alternative-flow processing belongs to the existing specification, not use-case dependencies.
actor "Patient / General User" as Actor1
rectangle "Medication Safety Assistant" {
  usecase "Record Dose Status" as Main
  usecase "Review and Confirm Dose Entry" as Confirm
  Main ..> Confirm : <<include>>
  note top of Main
    The patient reports Taken, Missed or Skipped
    for an accessible scheduled dose.
    A missing report is not proof of a missed dose.
  end note
  note bottom of Confirm
    Corrections show the previous status for
    comparison and require confirmation.
    Cancellation or failure changes no entry;
    the recorded time is retained on success.
  end note
}
Actor1 -- Main
@enduml
