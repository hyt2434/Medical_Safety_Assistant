@startuml UC_01
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 40
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-01: Sign In

' Figure 1 / UC-01; diagrams only.
' Text source: pa/pa2/Use-Case-Specification/sections/02-use-case-specifications.tex
' Alternative-flow processing belongs to the existing specification, not use-case dependencies.
actor "Registered User" as Actor1
rectangle "Medication Safety Assistant" {
  usecase "Sign In" as Main
  usecase "Validate Credentials\nand Account Status" as Credentials
  usecase "Verify Assigned Roles\nand Permissions" as Permissions
  Main ..> Credentials : <<include>>
  Main ..> Permissions : <<include>>
  note bottom of Main
    A successful sign-in creates a session
    with verified role permissions.
    Invalid credentials, blocked accounts or
    unavailable roles create no session.
  end note
}
Actor1 -- Main
@enduml
