@startuml UC_15
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 40
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-15: Manage User Accounts and Roles

' Figure 15 / UC-15; diagrams only.
' Text source: pa/pa2/Use-Case-Specification/sections/02-use-case-specifications.tex
' Alternative-flow processing belongs to the existing specification, not use-case dependencies.
actor "Administrator" as Actor1
rectangle "Medication Safety Assistant" {
  usecase "Manage User Accounts and Roles" as Main
  usecase "Create an Account" as Create
  usecase "Update Account Details,\nStatus or Roles" as Update
  usecase "Validate Account and RBAC Rules" as Validate
  Create -|> Main
  Update -|> Main
  Main ..> Validate : <<include>>
  note bottom of Validate
    Only permitted account and role changes
    may be confirmed and stored with an activity record.
    Cancellation or failure preserves prior settings;
    unauthorized changes grant no extra permissions.
  end note
}
Actor1 -- Main
@enduml
