@startuml UC_06
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 40
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-06: Set Up Medication Reminders

' Figure 6 / UC-06; diagrams only.
' Text source: pa/pa2/Use-Case-Specification/sections/02-use-case-specifications.tex
' Alternative-flow processing belongs to the existing specification, not use-case dependencies.
actor "Patient / General User" as Actor1
rectangle "Medication Safety Assistant" {
  usecase "Set Up Medication Reminders" as Main
  usecase "Review and Confirm\nRecorded Schedule" as Confirm
  usecase "Check Schedule Verification\nand Applicable Safety Restrictions" as Gate
  Main ..> Confirm : <<include>>
  Main ..> Gate : <<include>>
  note bottom of Confirm
    No activation without a verified schedule.
    Proposed new timing awaits the required
    simulated confirmation; review requests
    are handled separately through UC-04.
  end note
  note bottom of Gate
    Severe findings hold affected NEW reminders;
    existing reminders are not stopped automatically.
    Unassessed is not safe clearance; apply
    restrictions required by the review policy.
  end note
  note top of Main
    Browser notification failure is a delivery
    limitation: eligible schedules remain in-app.
  end note
}
Actor1 -- Main
@enduml
